{
  "name": "vscode-lisp",
  "displayName": "jig/lisp",
  "description": "Language support and debugger for the jig/lisp interpreter",
  "version": "0.9.2",
  "publisher": "jig",
  "icon": "./icons/icon.png",
  "license": "SEE LICENSE IN ../../LICENCE",
  "repository": {
    "type": "git",
    "url": "https://github.com/jig/lisp"
  },
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onDebugDynamicConfigurations:lisp",
    "onDebugResolve:lisp",
    "onLanguage:lisp",
    "workspaceContains:**/*_test.lisp",
    "workspaceContains:**/*_test.mal"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lisp",
        "aliases": [
          "jig/lisp",
          "Lisp"
        ],
        "extensions": [
          ".lisp",
          ".mal"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/lisp.svg",
          "dark": "./icons/lisp.svg"
        },
        "firstLine": "^#!.*\\blisp(-debug)?\\b"
      }
    ],
    "iconThemes": [
      {
        "id": "jig-lisp-icons",
        "label": "jig/lisp icons",
        "path": "./icons/lisp-icon-theme.json"
      }
    ],
    "grammars": [
      {
        "language": "lisp",
        "scopeName": "source.lisp",
        "path": "./syntaxes/lisp.tmLanguage.json"
      }
    ],
    "debuggers": [
      {
        "type": "lisp",
        "label": "jig/lisp",
        "languages": [
          "lisp"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the Lisp script to debug.",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Pause at the first form before any code runs.",
                "default": true
              },
              "env": {
                "type": "object",
                "description": "Environment variables passed to the lisp-debug process. Useful for LISP_DAP_TRACE=1 to print step-mode diagnostics on the debug console.",
                "default": {}
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the debuggee. Relative load-file paths and require's git-root search resolve against it.",
                "default": "${workspaceFolder}"
              },
              "preamble": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "description": "Preamble placeholder assignments for the script, e.g. [\"$NUMBER 1984\", \"$NAME \\\"world\\\"\"]. Passed to the interpreter as --preamble flags."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "lisp",
            "request": "launch",
            "name": "Debug current Lisp file",
            "program": "${file}",
            "stopOnEntry": true,
            "cwd": "${workspaceFolder}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "jig/lisp: Launch",
            "description": "Debug a Lisp script with jig/lisp.",
            "body": {
              "type": "lisp",
              "request": "launch",
              "name": "${1:Debug current Lisp file}",
              "program": "^\"\\${file}\"",
              "stopOnEntry": true
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "jig/lisp",
      "properties": {
        "lisp.debugAdapter.command": {
          "type": "string",
          "default": "lisp-debug",
          "description": "Path or name of the debug-build interpreter (built with `go build -tags lispdebug`). The extension spawns this as the DAP server."
        },
        "lisp.debugAdapter.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional arguments prepended before --dap when invoking the interpreter."
        },
        "lisp.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the LSP client (diagnostics, completion, hover, outline). Requires the lisp-debug binary."
        },
        "lisp.languageServer.command": {
          "type": "string",
          "default": "lisp-debug",
          "description": "Path or name of the debug-build interpreter spawned as the LSP server (with --lsp)."
        },
        "lisp.languageServer.includeDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Include directories for require module resolution in the editor (equivalent to the interpreter's -i/--include)."
        },
        "lisp.testRunner.command": {
          "type": "string",
          "default": "",
          "description": "Binary used by the Testing panel to run lisp tests (defaults to lisp.debugAdapter.command; needs a lispdebug build for coverage)."
        }
      }
    },
    "configurationDefaults": {
      "[lisp]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "jig.vscode-lisp",
        "editor.wordSeparators": "()[]{}\"'`~@^;,"
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "vscode:prepublish": "tsc -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.88.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
