{
  "name": "vscode-lisp",
  "displayName": "jig/lisp",
  "description": "Language support and debugger for the jig/lisp interpreter",
  "version": "0.1.0",
  "publisher": "jig",
  "license": "SEE LICENSE IN ../../LICENCE",
  "repository": {
    "type": "git",
    "url": "https://github.com/jig/lisp"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onDebugResolve:lisp",
    "onDebugDynamicConfigurations:lisp",
    "onLanguage:lisp"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lisp",
        "aliases": ["jig/lisp", "Lisp"],
        "extensions": [".lisp", ".mal"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lisp",
        "scopeName": "source.lisp",
        "path": "./syntaxes/lisp.tmLanguage.json"
      }
    ],
    "debuggers": [
      {
        "type": "lisp",
        "label": "jig/lisp",
        "languages": ["lisp"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the Lisp script to debug.",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Pause at the first form before any code runs.",
                "default": true
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "lisp",
            "request": "launch",
            "name": "Debug current Lisp file",
            "program": "${file}",
            "stopOnEntry": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "jig/lisp: Launch",
            "description": "Debug a Lisp script with jig/lisp.",
            "body": {
              "type": "lisp",
              "request": "launch",
              "name": "${1:Debug current Lisp file}",
              "program": "^\"\\${file}\"",
              "stopOnEntry": true
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "jig/lisp",
      "properties": {
        "lisp.debugAdapter.command": {
          "type": "string",
          "default": "lisp-debug",
          "description": "Path or name of the debug-build interpreter (built with `go build -tags lispdebug`). The extension spawns this as the DAP server."
        },
        "lisp.debugAdapter.extraArgs": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Additional arguments prepended before --dap when invoking the interpreter."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "vscode:prepublish": "tsc -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
