0xCA_FE_CA_FE
;=>0xCAFECAFE

;; tests from Go package text/scanner

;; decimal ints
0
;=>0
1
;=>1
9
;=>9
42
;=>42
1234567890
;=>1234567890

;; leading-zero octal is error-prone and rejected: use 0o instead
042
;/.*leading-zero octal literal not supported.*
;=>nil
00
;/.*leading-zero octal literal not supported.*
;=>nil

;; Radix-prefixed literals (0x, 0o, 0b) are unsigned arbitrary-precision
;; data numbers: they read as big ints and print back as 0x… hex padded
;; to whole octets. Decimal literals stay machine ints.
0x0
;=>0x00
0x1
;=>0x01
0xf
;=>0x0F
0x42
;=>0x42
0x123456789abcDEF
;=>0x0123456789ABCDEF
0o17
;=>0x0F
0b101
;=>0x05
;; they exceed the machine word without overflow
0xFFFF_FFFF_FFFF_FFFF_FFFF
;=>0xFFFFFFFFFFFFFFFFFFFF
;; numeric equality, not pointer identity; and distinct from ints
(= 0x0A 0x0A)
;=>true
(= 0x0A 10)
;=>false
;; radix literals carry no sign
-0x01
;/.*sign not allowed in radix literal.*
;=>nil

0.
;=>0
1.
;=>1
42.
;=>42
01234567890.
;=>1.234568e+09
.0
;=>0
.1
;=>0.1
.42
;=>0.42

